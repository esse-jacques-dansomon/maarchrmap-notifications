#API
PORT=3000
GLOBAL_PREFIX=api

#DATABASE
DATABASE_HOST=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_PORT=

#JWT
JWT_KEY=dev
JWT_EXPIRES=365d

#MAIL
MAIL_HOST=
MAIL_PORT=
MAILER_SECURE=
MAILER_TLS=tls
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# Notifications - Mode de distribution
# - restricted : Service des archives + Service versant uniquement
# - all : tout le monde (expéditeur + utilisateurs de toutes les organisations de l'événement)
NOTIFICATION_MODE=restricted

# Notifications - Service des archives (liste séparée par des virgules)
# Utilisé uniquement en mode "restricted"
# Défaut: bdiarra@boad.org,etokplo@boad.org,aouro@boad.org,jtchalekou@boad.org
ARCHIVE_SERVICE_EMAILS=bdiarra@boad.org,etokplo@boad.org,aouro@boad.org,jtchalekou@boad.org

# URL du SAE (Système d'Archivage Électronique) pour les liens dans les notifications
SAE_URL=https://sae.boad.org/

